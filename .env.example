# Example environment configuration. Copy this file to .env and fill in the values.

# Required: Generate a random secret key for session cookies
# Run: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here

# Required: Generate a hash of your admin password
# Run: python3 -c "from werkzeug.security import generate_password_hash as g; print(g(input()))"
# Then copy the hash here (wrap in single quotes in .env if it contains special chars)
ADMIN_PASSWORD_HASH=your-password-hash-here

# Optional: OpenAI API key for AI-powered recipe parsing
# Get one at: https://platform.openai.com/api-keys
# Without this, the AI parser is disabled but manual recipe entry still works
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Enable Flask debug mode for local development (plain http)
# Set to 1 for development, leave unset or 0 for production
FLASK_DEBUG=1

# Optional: PostgreSQL connection string for production (Render, etc.)
# If not set, the app uses local SQLite (development only)
# Example: postgresql://user:password@localhost:5432/recipeapp
# DATABASE_URL=

